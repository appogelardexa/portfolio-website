<section id="projects">
  <div class="section-container">
    <span class="section-label">03 — Work</span>
    <h2 class="section-heading">Projects</h2>
    <p class="section-subheading">Selected work I'm proud of.</p>

    <div class="grid md:grid-cols-2 gap-5">
      {
        projects.map((project) => (
          <div class="glass-card p-7 flex flex-col">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 rounded-lg bg-accent-500/15 flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.75V12A2.25 2.25 0 014.5 9.75h15A2.25 2.25 0 0121.75 12v.75m-8.69-6.44l-2.12-2.12a1.5 1.5 0 00-1.061-.44H4.5A2.25 2.25 0 002.25 6v12a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9a2.25 2.25 0 00-2.25-2.25h-5.379a1.5 1.5 0 01-1.06-.44z" />
                </svg>
              </div>
              <h3 class="text-white font-semibold text-lg">
                {project.title}
              </h3>
            </div>
            <p class="text-surface-400 text-sm leading-relaxed mb-5 flex-grow max-w-lg">
              {project.description}
            </p>
            <div class="flex flex-wrap gap-2">
              {project.tech.map((t) => (
                <span class="tag">{t}</span>
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <!-- Other Automation Systems collapsible -->
    <div class="mt-10">
      <button
        id="other-projects-toggle"
        class="flex items-center gap-3 text-surface-300 hover:text-white transition-colors group"
        aria-expanded="false"
        aria-controls="other-projects"
      >
        <span class="text-sm font-medium">Other Automation Systems</span>
        <svg
          id="other-projects-chevron"
          class="w-4 h-4 transition-transform duration-300"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </button>

      <div
        id="other-projects"
        class="grid md:grid-cols-2 gap-5 overflow-hidden transition-all duration-500"
        style="max-height: 0; opacity: 0; margin-top: 0;"
      >
        {
          otherProjects.map((project) => (
            <div class="glass-card p-7 flex flex-col">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 rounded-lg bg-accent-500/15 flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.75V12A2.25 2.25 0 014.5 9.75h15A2.25 2.25 0 0121.75 12v.75m-8.69-6.44l-2.12-2.12a1.5 1.5 0 00-1.061-.44H4.5A2.25 2.25 0 002.25 6v12a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9a2.25 2.25 0 00-2.25-2.25h-5.379a1.5 1.5 0 01-1.06-.44z" />
                  </svg>
                </div>
                <h3 class="text-white font-semibold text-lg">
                  {project.title}
                </h3>
              </div>
              <p class="text-surface-400 text-sm leading-relaxed mb-5 flex-grow max-w-lg">
                {project.description}
              </p>
              <div class="flex flex-wrap gap-2">
                {project.tech.map((t) => (
                  <span class="tag">{t}</span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  const toggle = document.getElementById('other-projects-toggle');
  const panel = document.getElementById('other-projects');
  const chevron = document.getElementById('other-projects-chevron');

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    if (isOpen) {
      panel!.style.maxHeight = '0';
      panel!.style.opacity = '0';
      panel!.style.marginTop = '0';
      toggle.setAttribute('aria-expanded', 'false');
      chevron!.style.transform = 'rotate(0deg)';
    } else {
      panel!.style.maxHeight = panel!.scrollHeight + 'px';
      panel!.style.opacity = '1';
      panel!.style.marginTop = '1.25rem';
      toggle.setAttribute('aria-expanded', 'true');
      chevron!.style.transform = 'rotate(180deg)';
    }
  });
</script>
